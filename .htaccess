Options +FollowSymlinks
RewriteEngine On

# Deny direct access to anything outside web/ (source, config, vendor, .env, composer.*, etc.)
# Excludes the site root itself: REQUEST_FILENAME for "/" resolves to DOCUMENT_ROOT,
# which is itself a directory (-d true), so without this it blocks the homepage too.
RewriteCond %{REQUEST_URI} !^/web/
RewriteCond %{REQUEST_FILENAME} !^%{DOCUMENT_ROOT}/?$
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [F,L]

# Forward requests for files/dirs that exist under web/
RewriteCond %{REQUEST_URI} !^/web/
RewriteCond %{DOCUMENT_ROOT}/web%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}/web%{REQUEST_URI} -d
RewriteRule ^(.*)$ web/$1 [L,QSA]

# Forward everything else to web/index.php (Yii2 router)
RewriteCond %{REQUEST_URI} !^/web/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ web/index.php [L,QSA]
